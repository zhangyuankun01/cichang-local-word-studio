{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "black-rain-e57e",
  "main": "src/index.js",
  "account_id": "ce658c118bd198dc6bf7c6c715f6b1eb",
  "compatibility_date": "2026-09-29",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "TTS_RATE_LIMITER",
      "namespace_id": "57057",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}

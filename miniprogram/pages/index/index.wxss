page{background:#f7f6f2;color:#24352d;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.app-shell{padding:38rpx 34rpx 150rpx;min-height:100vh;box-sizing:border-box}.topline{display:flex;align-items:center;justify-content:space-between;margin:10rpx 0 38rpx}.eyebrow{font-size:18rpx;letter-spacing:3rpx;color:#87948c}.title{font:500 44rpx Georgia,"Songti SC",serif;margin-top:8rpx}.pill{color:#64746a;background:#eeeee8;border-radius:30rpx;padding:12rpx 20rpx;font-size:22rpx}.progress-row{display:flex;justify-content:space-between;color:#78847c;font-size:22rpx;margin-bottom:15rpx}.progress{height:7rpx;border-radius:9rpx;background:#e7e8e1;margin-bottom:32rpx}.progress view{height:100%;background:#65816d;border-radius:9rpx}.word-card,.empty-card,.setting-card{background:#fffefa;border:1rpx solid #ecebe4;border-radius:28rpx;padding:38rpx 32rpx;box-shadow:0 10rpx 32rpx rgba(32,48,38,.035)}.word-meta{display:flex;justify-content:space-between;color:#93a097;font-size:22rpx}.word{font:500 66rpx Georgia,serif;margin:44rpx 0 28rpx;color:#24372c}.hidden-word{font:400 34rpx Georgia,serif;color:#a2aaa4;padding:17rpx 0}.listen{margin:0 0 34rpx 0;width:auto;height:auto;line-height:1.5;background:#f0f3ed;border-radius:30rpx;color:#526c59;font-size:22rpx;padding:13rpx 23rpx}.listen::after,.answers button::after,.continue::after,.reveal::after,.tabbar button::after,.filter::after,.small-action::after,.mode::after,.outline-button::after,.play-mini::after{border:0}.meaning{font-size:32rpx;line-height:1.6;margin:10rpx 0 24rpx}.example{font:italic 25rpx/1.7 Georgia,serif;color:#778279;border-top:1rpx solid #efeee8;padding-top:22rpx}.example text{display:block;font:24rpx/1.7 -apple-system,sans-serif;margin-top:5rpx}.answers{display:flex;gap:18rpx;margin-top:34rpx}.answers button{flex:1;border-radius:16rpx;font-size:28rpx;height:90rpx;line-height:90rpx}.again{background:#f4eee8;color:#966b50}.known,.continue{background:#526f5b;color:white}.feedback{background:#f3f4ef;border-radius:14rpx;margin-top:28rpx;padding:20rpx;color:#58705e;font-size:24rpx}.continue{border-radius:16rpx;margin:28rpx 0 0;width:100%;height:90rpx;line-height:90rpx}.reveal{background:transparent;color:#77847a;font-size:22rpx;margin-top:15rpx}.mode-row{display:flex;gap:15rpx;margin:23rpx 0}.mode{background:#eeeee8;border-radius:14rpx;font-size:23rpx;color:#7b867f;flex:1}.mode.selected{background:#e4ebe2;color:#405b48}.footnote,.muted{color:#929b94;font-size:21rpx;line-height:1.7}.footnote{text-align:center;padding:6rpx 15rpx}.empty-card{text-align:center;padding:65rpx 35rpx}.empty-icon{font-size:50rpx;color:#718a75}.empty-title{font:500 38rpx Georgia,serif;margin:20rpx}.library-actions{display:flex;gap:14rpx}.search{flex:1;background:white;border:1rpx solid #e9e9e2;border-radius:14rpx;padding:18rpx 20rpx;font-size:24rpx}.small-action{background:#526f5b;color:white;border-radius:14rpx;font-size:23rpx;padding:0 20rpx}.filter-row{display:flex;justify-content:space-between;margin:22rpx 0}.filter{background:transparent;color:#8b958e;font-size:21rpx;padding:10rpx 16rpx}.filter.active{background:#e7ece5;color:#49634e;border-radius:20rpx}.word-row{display:flex;align-items:center;background:#fffefa;padding:23rpx 20rpx;border-bottom:1rpx solid #f0efe9}.word-copy{flex:1;min-width:0}.row-word{font:500 30rpx Georgia,serif}.row-word text{font:22rpx -apple-system,sans-serif;color:#9aa29b;margin-left:10rpx}.row-meaning{color:#849087;font-size:22rpx;margin-top:8rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.play-mini{background:#edf1eb;border-radius:50%;color:#5d755f;width:60rpx;height:60rpx;line-height:60rpx;margin-left:10rpx;font-size:20rpx}.empty-list{text-align:center;padding:50rpx}.setting-card{margin-bottom:22rpx;padding:30rpx}.setting-title{font-size:29rpx;font-weight:600;margin-bottom:18rpx}.setting-line{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0;border-top:1rpx solid #f0efe9;font-size:25rpx}.setting-line input{width:130rpx;text-align:right;background:#f5f5f0;border-radius:10rpx;padding:12rpx;font-size:26rpx}.endpoint{font-size:22rpx;color:#59745e;margin-top:15rpx}.outline-button{display:block;margin:17rpx 0 0 0;width:100%;font-size:23rpx;background:#f4f5f0;color:#516b57;border-radius:14rpx}.audio-count{margin-top:15rpx}.tabbar{position:fixed;bottom:0;left:0;right:0;display:flex;padding:15rpx 20rpx calc(15rpx + env(safe-area-inset-bottom));background:rgba(255,254,250,.97);border-top:1rpx solid #eae9e3}.tabbar button{flex:1;background:transparent;color:#9aa19b;font-size:23rpx}.tabbar button.chosen{color:#405d47;font-weight:600}

.answers .fuzzy{background:#f4edda;color:#8c733e}.answers button{font-size:25rpx;padding:0 5rpx}.word{overflow-wrap:anywhere}.recall-prompt{padding:22rpx 0;color:#7d897e;font-size:25rpx;line-height:1.8}.recall-prompt text{display:block;color:#a1a79f;font-size:22rpx}.warning{background:#f8efe1;color:#8c683a;padding:18rpx;border-radius:12rpx;margin:15rpx 0;font-size:22rpx;line-height:1.7}.delete-mini{background:transparent;color:#a38a79;font-size:19rpx;padding:0 12rpx;margin:0}.delete-mini::after{border:0}.preview-row{padding:15rpx 0;border-bottom:1rpx solid #ecece3;font-size:23rpx}.editor-mask{position:fixed;z-index:20;inset:0;background:rgba(24,40,29,.45);display:flex;align-items:center;padding:30rpx;box-sizing:border-box}.editor-card{max-height:85vh;width:100%;background:#fffefa;border-radius:24rpx;padding:28rpx;box-sizing:border-box}.editor-card label{display:block;color:#69796b;font-size:22rpx;margin:12rpx 0}.editor-card input,.editor-card textarea{box-sizing:border-box;width:100%;padding:18rpx;background:#f4f5ef;border-radius:12rpx;margin:10rpx 0;font-size:27rpx;color:#293b2d}.editor-card textarea{height:140rpx}.setting-card>.muted{margin-top:15rpx}

.editor-card{height:85vh}
